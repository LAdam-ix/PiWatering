SENSOR_RAW_WET = 0.2
SENSOR_RAW_DRY = 0.6
VM_URL = "http://localhost:8428"
FLASK_SECRET_KEY = "change-me"
FLASK_PORT = 5000

# ---- Logging ----
# The app's own events (valve opened/closed, "metrics write failed", startup ...)
# are tagged [piwater] and are always logged; LOG_LEVEL only sets verbosity.
#   LOG_LEVEL: DEBUG | INFO | WARNING | ERROR | CRITICAL   (default INFO)
LOG_LEVEL = "INFO"

# Optional file to ALSO write logs into (absolute path). Empty = console/journal only.
LOG_FILE = ""

# Werkzeug HTTP access log (one line per request the server handles - from any
# client: the frontend's fetches, browser page loads, static assets, etc.).
# The frequent background poll (GET /valves/status) is ALWAYS filtered out so it
# doesn't spam; real requests (page loads, valve On/Off, errors) are still shown.
#   false = filter out only the poll spam (default)
#   true  = log ALL requests, including the poll (debug/monitoring)
# Does NOT affect the [piwater] app logs above.
ACCESS_LOG = "false"
